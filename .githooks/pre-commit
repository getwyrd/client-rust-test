#!/usr/bin/env bash
# Secret guard for client-rust-test. core.hooksPath=.githooks bypasses the hook that
# `pre-commit install` would write to .git/hooks, so run the secret guard here.
# Fails closed: without pre-commit the commit is refused (bypass: git commit --no-verify).
set -euo pipefail
if ! command -v pre-commit >/dev/null 2>&1; then
    echo "pre-commit: not installed; run: pipx install pre-commit" >&2
    exit 1
fi
# Read a copy of the config taken from the default branch, not the checked-out file, so a
# branch (a fork PR checked out locally) cannot redefine what runs on commit.
# The copies (and the pinned gitleaks policy) come from: git show origin/HEAD:.secret-guard/activate.sh | sh
d=$(git rev-parse --path-format=absolute --git-common-dir)
if [ ! -f "$d/secret-guard.yaml" ] || [ ! -f "$d/secret-guard-gitleaks.toml" ]; then
    echo "pre-commit: secret guard not activated; run:" >&2
    echo "  git show origin/HEAD:.secret-guard/activate.sh | sh" >&2
    exit 1
fi
GITLEAKS_CONFIG="$d/secret-guard-gitleaks.toml" exec pre-commit run --config "$d/secret-guard.yaml" --hook-stage pre-commit
