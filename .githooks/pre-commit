#!/usr/bin/env bash
# Secret guard for client-rust-test. core.hooksPath=.githooks bypasses the hook that
# `pre-commit install` would write to .git/hooks, so run the secret guard here.
# Fails closed: without pre-commit the commit is refused (bypass: git commit --no-verify).
set -euo pipefail
if ! command -v pre-commit >/dev/null 2>&1; then
    echo "pre-commit: not installed; run: pipx install pre-commit" >&2
    exit 1
fi
# The guard runner and its reviewed copies are written by .secret-guard/activate.sh, which
# also checks that this hook ends with the line below. Activate with:
#   s=$(git show origin/HEAD:.secret-guard/activate.sh) && sh -c "$s" activate
if [ ! -x "$(git rev-parse --path-format=absolute --git-common-dir)/secret-guard-run" ]; then
    echo "pre-commit: secret guard not activated; run:" >&2
    echo '  s=$(git show origin/HEAD:.secret-guard/activate.sh) && sh -c "$s" activate' >&2
    exit 1
fi
exec "$(git rev-parse --path-format=absolute --git-common-dir)/secret-guard-run" "$@"
